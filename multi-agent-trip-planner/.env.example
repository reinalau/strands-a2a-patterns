# ─────────────────────────────────────────────────────────────────────────────
# multi-agent-trip-planner — environment variables
# Copy this file to .env  (cp .env.example .env)  and fill in your API key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini (orchestrator) ────────────────────────────────────────────────────
# Google AI Studio API key: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used by the orchestrator. LiteLLM expects the "gemini/" prefix.
# Free-tier options: gemini-3.6-flash, gemini-3.5-flash-lite.
# (gemini-2.5-flash is no longer available to new users.)
ORCHESTRATOR_MODEL_ID=gemini/gemini-3.5-flash-lite

# Sampling temperature for the orchestrator. Google recommends 1.0 for
# Gemini 3+ models (lower values can cause loops and degrade reasoning on
# multi-step tool-using tasks).
ORCHESTRATOR_TEMPERATURE=1.0

# ── LLM judge (used by the evals) ────────────────────────────────────────────
# The judge that scores responses in evals/. Defaults to ORCHESTRATOR_MODEL_ID
# if unset. Point it at a more available model if the orchestrator's one is
# saturated (503 "high demand").
JUDGE_MODEL_ID=gemini/gemini-3.5-flash-lite
# Google recommends temperature 1.0 for Gemini 3+ (lower degrades reasoning).
JUDGE_TEMPERATURE=1.0

# ── Ollama / Gemma (local specialist agents) ─────────────────────────────────
# Ollama server address (Docker exposes 11434 by default).
OLLAMA_HOST=http://localhost:11434

# Local model run by the three specialist A2A agents.
REMOTE_MODEL_ID=gemma4:e2b-it-qat

# ── Specialist A2A servers ───────────────────────────────────────────────────
# Host and port where each specialist publishes its agent and its agent card.
# The three run as separate processes, each on its own port.
FLIGHTS_HOST=127.0.0.1
FLIGHTS_PORT=9001
HOTELS_HOST=127.0.0.1
HOTELS_PORT=9002
ITINERARY_HOST=127.0.0.1
ITINERARY_PORT=9003

# Discovery list the orchestrator hands to A2AClientToolProvider. Optional:
# if left unset, it is derived automatically from the ports above. Override it
# (comma-separated URLs) only if you run the specialists elsewhere.
# SPECIALIST_AGENT_URLS=http://localhost:9001,http://localhost:9002,http://localhost:9003

# Per-request A2A timeout (seconds) the orchestrator uses to call a specialist.
# Local Gemma inference is slow and the three agents may queue on a
# single-parallel Ollama, so this defaults higher than the SDK's 300s.
A2A_CLIENT_TIMEOUT=600

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level for every process: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
